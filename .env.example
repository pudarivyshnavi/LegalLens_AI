# --- Frontend (Vite) ---
# These are pre-populated by the Bolt environment. Do not modify.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- AI Provider (optional) ---
# Configure these in your Supabase project's edge function secrets to enable
# LLM-powered analysis. When not set, the app uses a built-in heuristic analyzer.
AI_API_KEY=your_ai_api_key
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
